# ============================================================
# SehatSaathi AI — Environment Variables Reference
# ============================================================
# Copy this file to backend/.env.local and fill in real values.
# NEVER commit .env.local to version control.

# ── AI Models ────────────────────────────────────────────────
# Groq API — powers the AI Assistant chat
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Appwrite Backend ─────────────────────────────────────────
# Dashboard: https://cloud.appwrite.io
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id
NEXT_PUBLIC_APPWRITE_BUCKET_ID=your_bucket_id
NEXT_PUBLIC_APPWRITE_COLLECTION_ORDERS=orders
NEXT_PUBLIC_APPWRITE_COLLECTION_REVIEWS=reviews
VITE_APPWRITE_REVIEWS_ID=review

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Email (Nodemailer for order confirmations) ────────────────
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_gmail_app_password

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=your_strong_jwt_secret_here

# ── Server ────────────────────────────────────────────────────
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
